    "motion": "^14.10.1",
    "next": "16.2.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.11.1"
